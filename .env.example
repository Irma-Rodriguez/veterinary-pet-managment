# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git: never commit real passwords or URLs.

# PostgreSQL connection string.
# Neon: Dashboard > your project > Connect > copy the connection string
# (it ends with ?sslmode=require).
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Password for all demo accounts created by `npm run db:seed`
# (admin@, frontdesk@, owner@, and the vets @pawhaven.example).
SEED_PASSWORD="change-me-123"

# Secret key that signs the session cookies. Each developer generates their own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="paste-the-generated-value-here"
